{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed context provider input (not implemented)",
  "type": "object",
  "properties": {
    "native": {
      "allOf": [
        {
          "$ref": "../upstream/context-request.schema.json"
        }
      ],
      "unevaluatedProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "relevant",
            "page-text",
            "raw"
          ],
          "default": "relevant"
        },
        "maxResults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144,
          "default": 32768
        },
        "maxCharactersPerResult": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 2000
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "native"
  ],
  "additionalProperties": false
}
